# ============================================================
# PortLink Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to source control.
# ============================================================

# ----------------------------------------------------------
# Supabase
# Get these from: https://supabase.com/dashboard/project/<id>/settings/api
# ----------------------------------------------------------

# Public URL for your Supabase project (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon/public key — used in browser and server components (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service role key — server-side only (webhooks, cron jobs). NEVER expose client-side.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ----------------------------------------------------------
# SendGrid Inbound Parse
# Configure at: https://app.sendgrid.com/settings/parse
# The webhook secret is a shared secret you define — used to verify inbound requests.
# ----------------------------------------------------------
SENDGRID_INBOUND_PARSE_WEBHOOK_SECRET=<your-webhook-secret>

# ----------------------------------------------------------
# Twilio (SMS Alerts)
# Get these from: https://www.twilio.com/console
# ----------------------------------------------------------
TWILIO_ACCOUNT_SID=AC<your-account-sid>
TWILIO_AUTH_TOKEN=<your-auth-token>

# The Twilio phone number to send SMS from (E.164 format, e.g. +12345678900)
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ----------------------------------------------------------
# Cron Jobs
# A secret token used to authenticate Vercel Cron job requests.
# Generate with: openssl rand -hex 32
# Set the same value in Vercel project environment variables.
# ----------------------------------------------------------
CRON_SECRET=<generate-with-openssl-rand-hex-32>
